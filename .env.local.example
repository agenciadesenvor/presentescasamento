# Copie para .env.local e preencha. Sem isso, o site roda em "modo demonstração"
# (lê os presentes do seed e o botão de presentear mostra um aviso).

# --- Supabase (banco, auth do admin, storage de fotos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (checkout PIX/cartão) ---
# Comece com as credenciais de TESTE do seu app no painel do Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# --- URL pública do site (usada nos retornos e no webhook do Mercado Pago) ---
# Em produção: https://seu-dominio.com  |  Em dev/preview: a URL do Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
